  "runId": "20261107T073741Z-c1c3ad39168e",
  "contracts": [
    {
      "id": "ui.counter",
      "file": "contracts/counter.contract.yaml",
      "props": [
        {
          "name": "start",
          "type": "integer",
          "default": 0,
          "hasDefault": true
        }
      ],
      "events": [
        {
          "name": "changed",
          "fields": [
            {
              "name": "count",
              "type": "integer",
              "hasDefault": false
            }
          ]
        }
      ],
      "parts": [
        {
          "name": "value",
          "role": "status",
          "id": "ui.counter.value"
        },
        {
          "name": "increment",
          "role": "button",
          "id": "ui.counter.increment"
        }
      ],
      "tests": [
        {
          "name": "starts at the start value",
          "props": {
            "start": 5
          },
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "5"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "each press adds one",
          "steps": [
            {
              "action": "press",
              "part": "increment",
              "times": 3
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "3"
                }
              ]
            },
            {
              "event": "changed",
              "times": 3,
              "last": {
                "count": 3
              }
            }
          ],
          "screenshot": true
        },
        {
          "name": "the keyboard works too",
          "steps": [
            {
              "action": "focus",
              "part": "increment",
              "times": 1
            },
            {
              "action": "key",
              "part": "increment",
              "key": "Enter",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "1"
                }
              ]
            },
            {
              "part": "increment",
              "checks": [
                {
                  "field": "name",
                  "want": "Increment"
                }
              ]
            }
          ]
        }
      ],
      "viewports": [
        {
          "width": 320,
          "height": 240
        }
      ],
      "colorSchemes": [
        "light",
        "dark"
      ],
      "pixelThreshold": 30,
      "timingThreshold": 20
    },
    {
      "id": "ui.switch",
      "file": "contracts/switch.contract.yaml",
      "props": [
        {
          "name": "on",
          "type": "boolean",
          "default": false,
          "hasDefault": true
        },
        {
          "name": "label",
          "type": "string",
          "default": "Dark mode",
          "hasDefault": true
        }
      ],
      "events": [
        {
          "name": "toggled",
          "fields": [
            {
              "name": "on",
              "type": "boolean",
              "hasDefault": false
            }
          ]
        }
      ],
      "parts": [
        {
          "name": "switch",
          "role": "switch",
          "id": "ui.switch.switch"
        },
        {
          "name": "thumb",
          "role": "generic",
          "id": "ui.switch.thumb"
        }
      ],
      "tests": [
        {
          "name": "starts off, with its label as its name",
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": false
                },
                {
                  "field": "name",
                  "want": "Dark mode"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "starts on when asked",
          "props": {
            "label": "Wi-Fi",
            "on": true
          },
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                },
                {
                  "field": "name",
                  "want": "Wi-Fi"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "a press turns it on, and the thumb slides across",
          "steps": [
            {
              "action": "press",
              "part": "switch",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                }
              ]
            },
            {
              "event": "toggled",
              "times": 1,
              "last": {
                "on": true
              }
            }
          ],
          "screenshot": true,
          "trace": [
            {
              "part": "thumb",
              "point": "center",
              "timing": {
                "durationMs": 200,
