      "tests": [
        {
          "name": "starts off, with its label as its name",
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": false
                },
                {
                  "field": "name",
                  "want": "Dark mode"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "starts on when asked",
          "props": {
            "label": "Wi-Fi",
            "on": true
          },
