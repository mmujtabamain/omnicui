            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                },
                {
                  "field": "name",
                  "want": "Wi-Fi"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "a press turns it on, and the thumb slides across",
          "steps": [
            {
              "action": "press",
              "part": "switch",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                }
              ]
            },
            {
              "event": "toggled",
              "times": 1,
              "last": {
                "on": true
              }
            }
          ],
          "screenshot": true,
          "trace": [
            {
              "part": "thumb",
              "point": "center",
              "timing": {
                "durationMs": 200,
