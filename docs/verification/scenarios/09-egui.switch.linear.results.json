              "part": "switch",
              "times": 1
            },
            {
              "action": "key",
              "part": "switch",
              "key": "Space",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                }
              ]
            },
            {
              "event": "toggled",
              "times": 1
            }
          ]
        }
      ],
