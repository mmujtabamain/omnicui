              "key": "Space",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                }
              ]
            },
            {
              "event": "toggled",
              "times": 1
            }
          ]
        }
      ],
