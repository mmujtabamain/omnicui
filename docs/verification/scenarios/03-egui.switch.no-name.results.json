      "tests": [
        {
          "name": "starts off, with its label as its name",
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": false
                },
                {
                  "field": "name",
                  "want": "Dark mode"
                }
              ]
