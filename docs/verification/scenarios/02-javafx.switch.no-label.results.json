  "contracts": [
    {
      "id": "ui.switch",
      "file": "contracts/switch.contract.yaml",
      "props": [
        {
          "name": "on",
          "type": "boolean",
          "default": false,
          "hasDefault": true
        },
        {
          "name": "label",
          "type": "string",
          "default": "Dark mode",
          "hasDefault": true
        }
      ],
      "events": [
        {
          "name": "toggled",
          "fields": [
            {
              "name": "on",
              "type": "boolean",
              "hasDefault": false
            }
          ]
        }
      ],
      "parts": [
        {
          "name": "switch",
          "role": "switch",
          "id": "ui.switch.switch"
        },
        {
          "name": "thumb",
          "role": "generic",
          "id": "ui.switch.thumb"
        }
      ],
      "tests": [
        {
          "name": "starts off, with its label as its name",
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": false
                },
                {
                  "field": "name",
                  "want": "Dark mode"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "starts on when asked",
          "props": {
            "label": "Wi-Fi",
            "on": true
          },
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                },
                {
                  "field": "name",
                  "want": "Wi-Fi"
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "a press turns it on, and the thumb slides across",
          "steps": [
            {
              "action": "press",
              "part": "switch",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                }
              ]
            },
            {
              "event": "toggled",
              "times": 1,
              "last": {
                "on": true
              }
            }
          ],
          "screenshot": true,
          "trace": [
            {
              "part": "thumb",
              "point": "center",
              "timing": {
                "durationMs": 200,
                "easing": "ease-out"
              }
            }
          ],
          "record": true
        },
        {
          "name": "Space toggles it from the keyboard",
          "steps": [
            {
              "action": "focus",
              "part": "switch",
              "times": 1
            },
            {
              "action": "key",
              "part": "switch",
              "key": "Space",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "switch",
              "checks": [
                {
                  "field": "checked",
                  "want": true
                }
              ]
            },
            {
              "event": "toggled",
              "times": 1
            }
          ]
        }
      ],
      "viewports": [
        {
          "width": 320,
          "height": 240
        }
      ],
      "colorSchemes": [
        "light",
        "dark"
      ],
      "pixelThreshold": 30,
