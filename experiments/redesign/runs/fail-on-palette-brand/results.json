          "screenshot": true
        },
        {
          "name": "each press adds one",
          "steps": [
            {
              "action": "press",
              "part": "increment",
              "times": 3
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "3"
                }
              ]
            },
            {
              "event": "changed",
              "times": 3,
              "last": {
                "count": 3
              }
            }
          ],
          "screenshot": true
        },
        {
