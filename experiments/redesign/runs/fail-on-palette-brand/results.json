              "times": 1
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "1"
                }
              ]
            },
            {
              "part": "increment",
              "checks": [
                {
                  "field": "name",
                  "want": "Increment"
                }
              ]
            }
          ]
