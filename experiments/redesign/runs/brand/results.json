              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "each press adds one",
          "steps": [
            {
              "action": "press",
              "part": "increment",
              "times": 3
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "3"
                }
              ]
            },
            {
              "event": "changed",
              "times": 3,
              "last": {
                "count": 3
              }
            }
          ],
          "screenshot": true
        },
        {
          "name": "the keyboard works too",
          "steps": [
            {
              "action": "focus",
              "part": "increment",
              "times": 1
            },
            {
              "action": "key",
              "part": "increment",
              "key": "Enter",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": "1"
                }
              ]
            },
            {
              "part": "increment",
              "checks": [
                {
                  "field": "name",
                  "want": "Increment"
                }
              ]
            }
          ]
        },
        {
          "name": "keyboard: Enter on `increment` does what a press does",
          "keyboard": {
