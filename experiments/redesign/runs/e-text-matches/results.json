        },
        {
          "name": "increment",
          "role": "button",
          "id": "ui.counter.increment"
        }
      ],
      "tests": [
        {
          "name": "starts at the start value",
          "props": {
            "start": 5
          },
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": {
                    "matches": "^5\\b"
                  }
                }
              ]
            }
          ],
          "screenshot": true
        },
        {
          "name": "each press adds one",
          "steps": [
            {
              "action": "press",
              "part": "increment",
              "times": 3
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": {
                    "matches": "^3\\b"
                  }
                }
              ]
            },
            {
              "event": "changed",
              "times": 3,
              "last": {
                "count": 3
              }
            }
          ],
          "screenshot": true
        },
        {
          "name": "the keyboard works too",
          "steps": [
            {
              "action": "focus",
              "part": "increment",
              "times": 1
            },
            {
              "action": "key",
              "part": "increment",
              "key": "Enter",
              "times": 1
            }
          ],
          "expect": [
            {
              "part": "value",
              "checks": [
                {
                  "field": "text",
                  "want": {
                    "matches": "^1\\b"
                  }
                }
              ]
            },
            {
              "part": "increment",
              "checks": [
                {
                  "field": "name",
                  "want": "Increment"
                }
              ]
            }
          ]
        },
        {
          "name": "keyboard: Enter on `increment` does what a press does",
          "keyboard": {
            "part": "increment",
            "key": "Enter"
          }
        },
        {
          "name": "keyboard: Space on `increment` does what a press does",
          "keyboard": {
            "part": "increment",
            "key": "Space"
          }
        }
      ],
