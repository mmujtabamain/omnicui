{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // React is the app's own (apps/web), so that the components run with the React they ship with.
    "paths": {
      "react": ["../../../apps/web/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../../apps/web/node_modules/@types/react/*.d.ts"],
      "react-dom": ["../../../apps/web/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["../../../apps/web/node_modules/@types/react-dom/*.d.ts"]
    }
  },
  "include": ["adapter.ts", "stubs.ts", "harness.tsx"]
}
