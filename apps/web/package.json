{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The web app, in React. Its components are also a library (./components), which the omnicui web target imports.",
  "exports": {
    "./components": "./src/components/index.ts",
    "./omnicui": "./src/omnicui/index.ts",
    "./static": "./static.ts"
  },
  "scripts": {
    "start": "node serve.ts",
    "test": "node --test static.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
