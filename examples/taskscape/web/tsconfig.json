{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@taskscape/common-ui/*": ["../tauri/common-ui/src/*"],
      "@shared/*": ["../tauri/main/src/*"],
      "@tauri-apps/api/event": ["./src/platform/events.ts"]
    }
  },
  "include": ["src"]
}
