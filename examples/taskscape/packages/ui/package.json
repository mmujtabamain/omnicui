{
  "name": "@taskscape/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Taskscape's widget library, built the way shadcn/ui is: one component per file, cva variants, Radix primitives, tokens as CSS variables. The apps use nothing else for UI.",
